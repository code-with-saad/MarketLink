# .env.example - dummy values only
# Copy this to server/.env and fill in real values. Never commit the real .env.

PORT=5000
MONGO_URI=mongodb://localhost:27017/marketlink
JWT_SECRET=replace_with_a_long_random_secret

# Admin Initial Seed
ADMIN_EMAIL=admin@marketlink.local
ADMIN_PASSWORD=admin_secure_password_123

# SMTP Email Configuration (for OTPs)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASS=mailer_password_here
SMTP_FROM="MarketLink Support <support@marketlink.local>"
# Client Origin (for CORS)
CLIENT_ORIGIN=http://localhost:5173
